<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.intent.get_network_state" />
    <uses-permission android:name="android.intent.action.NETWORK_SETTING" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:label="UET Parking"
        android:supportsRtl="true"
        android:theme="@style/Theme.UETParking">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.activity.BookingFormActivity"
            android:exported="false"
            android:theme="@style/Theme.UETParking" />

        <activity
            android:name=".ui.activity.SearchingActivity"
            android:exported="false"
            android:theme="@style/Theme.UETParking" />

        <activity
            android:name=".ui.activity.SuccessActivity"
            android:exported="false"
            android:theme="@style/Theme.UETParking" />

    </application>

</manifest>